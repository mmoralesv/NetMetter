<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NetMetter.AssetGen</RootNamespace>
  </PropertyGroup>

  <!-- Same drawing code as the running app, so the icons can never drift apart. -->
  <ItemGroup>
    <Compile Include="..\..\src\AppIcon.cs" Link="Shared\AppIcon.cs" />
    <Compile Include="..\..\src\NativeMethods.cs" Link="Shared\NativeMethods.cs" />
  </ItemGroup>

</Project>
